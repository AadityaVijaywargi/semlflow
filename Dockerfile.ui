# Serves the MLflow web GUI with the experiment results produced by the pipeline.
# Build AFTER running `make train` (needs mlflow.db and mlartifacts/ in the build context).
FROM python:3.12-slim
RUN pip install --no-cache-dir mlflow==3.16.1
WORKDIR /mlflow
COPY mlflow.db ./mlflow.db
COPY mlartifacts ./mlartifacts
EXPOSE 5000
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", \
     "--backend-store-uri", "sqlite:///mlflow.db", \
     "--artifacts-destination", "/mlflow/mlartifacts", \
     "--allowed-hosts", "*", "--cors-allowed-origins", "*"]
